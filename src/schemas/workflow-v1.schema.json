{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellizen.local/schemas/workflow-v1.schema.json",
  "title": "IntelliZen Workflow Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "trigger", "inputs", "steps"],
  "properties": {
    "schema": { "const": "intellizen.workflow/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "integer", "minimum": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manual", "panel-message"] }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "type": {
            "enum": ["string", "number", "boolean", "record-ref", "document-ref", "json"]
          },
          "database": { "type": "string", "minLength": 1 }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/roleAssignStep" },
          { "$ref": "#/$defs/conditionStep" },
          { "$ref": "#/$defs/approvalStep" },
          { "$ref": "#/$defs/artifactStep" },
          { "$ref": "#/$defs/decisionStep" }
        ]
      }
    }
  },
  "$defs": {
    "stepId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "next": {
      "type": ["string", "null"]
    },
    "baseStep": {
      "type": "object",
      "required": ["id", "kind", "title"]
    },
    "roleAssignStep": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "title",
            "role",
            "resolution",
            "instructions",
            "execution",
            "verification",
            "timeoutMinutes",
            "next"
          ],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "kind": { "const": "role-assign" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "role": { "type": "string", "minLength": 1 },
            "resolution": {
              "enum": ["primary-active-occupant", "explicit-agent-override"]
            },
            "agentOverride": { "type": ["string", "null"] },
            "overrideReason": { "type": ["string", "null"] },
            "modelOverride": { "type": ["string", "null"] },
            "instructions": { "type": "string", "minLength": 1 },
            "contextRefs": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "execution": { "enum": ["ephemeral", "durable"] },
            "mediatedAuthority": {
              "enum": ["read-only", "draft-only", "local-write", "room-write", "external-action-request"]
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required"],
              "properties": {
                "required": { "type": "boolean" },
                "method": { "type": ["string", "null"] }
              }
            },
            "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 240 },
            "next": { "$ref": "#/$defs/next" }
          }
        }
      ]
    },
    "conditionStep": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "expr", "then", "else"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "kind": { "const": "condition" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "expr": { "type": "string", "minLength": 1 },
            "then": { "type": "string", "minLength": 1 },
            "else": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "approvalStep": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "gate", "payloadRef", "next"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "kind": { "const": "approval" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "gate": { "type": "string", "minLength": 1 },
            "payloadRef": { "type": "string", "pattern": "^steps\\.[a-z][a-z0-9_-]*\\.result$" },
            "next": { "$ref": "#/$defs/next" }
          }
        }
      ]
    },
    "artifactStep": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "action", "template", "next"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "kind": { "const": "artifact" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "action": {
              "enum": ["create-doc", "revise-doc", "create-record", "simulate-consequential-action"]
            },
            "template": { "type": "string", "minLength": 1 },
            "payloadRef": { "type": ["string", "null"] },
            "next": { "$ref": "#/$defs/next" }
          }
        }
      ]
    },
    "decisionStep": {
      "allOf": [
        { "$ref": "#/$defs/baseStep" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "title", "rationale", "next"],
          "properties": {
            "id": { "$ref": "#/$defs/stepId" },
            "kind": { "const": "decision" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "rationale": { "type": "string", "minLength": 1 },
            "next": { "$ref": "#/$defs/next" }
          }
        }
      ]
    }
  }
}
